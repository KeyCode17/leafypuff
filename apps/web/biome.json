{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "asNeeded"
		}
	},
	"organizeImports": { "enabled": false },
	"files": { "ignore": ["src/routeTree.gen.ts", "dist"] },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"complexity": { "noUselessFragments": "off" }
		}
	}
}
